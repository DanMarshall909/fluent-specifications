---
import { Code } from 'astro:components';
import BaseLayout from '../layouts/BaseLayout.astro';
import snippets from '../generated/snippets.json';
import { parameterHintTransformer } from '../../tools/parameter-hint-transformer.mjs';

const description = 'Specifications for modern C#: terse business rules and fluent, provider-neutral searches without exposing IQueryable.';
const heroSymbol = 'M:FluentSpecifications.Examples.OrderFulfilment.ShippingExamples.PriorityShippingPage|local:request';
const priorityShippingPage = snippets[heroSymbol];
---

<BaseLayout title="Fluent Specifications" description={description} activePath="/">
  <section class="hero">
    <div class="site-shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Specifications for modern C# · zero third-party dependencies</p>
        <h1>Business rules that read like business rules.</h1>
        <p class="hero-lead">
          Compose named rules with terse, discoverable syntax—then evaluate them
          in memory or hand them to infrastructure without leaking a query API.
        </p>
        <div class="button-row">
          <a class="button button-primary" href="/docs/getting-started/">Get started</a>
          <a class="button button-secondary" href="/docs/testing/">See the tests</a>
        </div>
        <div class="package-callout" aria-label="NuGet installation command">
          <span>NuGet · latest</span>
          <code>dotnet add package DanMarshall.FluentSpecifications</code>
        </div>
      </div>
      <div class="code-window" aria-label="Fluent Specifications example">
        <div class="code-window-bar">
          <span>OrderSearch.cs</span>
          <span class="code-status">No IQueryable</span>
        </div>
        <Code
          code={priorityShippingPage}
          lang="csharp"
          theme="github-dark"
          meta={`symbol="${heroSymbol}"`}
          transformers={[parameterHintTransformer()]}
        />
      </div>
    </div>
  </section>

  <section class="lineage-section">
    <div class="site-shell lineage-row">
      <p>
        Informed by the internal Kotlin API used at Reapit and established
        specification libraries across C#, Java, Kotlin, TypeScript, and PHP.
      </p>
      <a class="text-link" href="/docs/prior-art/">Read the design lineage <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="principles-section">
    <div class="site-shell">
      <div class="section-heading">
        <p class="eyebrow">A deliberately small idea</p>
        <h2>Readable at the call site. Honest at the boundary.</h2>
      </div>
      <div class="principle-grid">
        <article>
          <span class="principle-number">01</span>
          <h3>Domain-first syntax</h3>
          <p>`CanShip.And.HighPriority` says what the rule means without ceremony or overloaded Boolean operators.</p>
        </article>
        <article>
          <span class="principle-number">02</span>
          <h3>One rule tree</h3>
          <p>The same immutable specification supports fast matching, structured diagnostics, rendering, and translation.</p>
        </article>
        <article>
          <span class="principle-number">03</span>
          <h3>No query leakage</h3>
          <p>Rules and immutable searches cross a provider-neutral repository boundary. EF Core is one materializing implementation.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="boundary-section">
    <div class="site-shell boundary-grid">
      <div>
        <p class="eyebrow">The useful boundary</p>
        <h2>Boolean rules in. Materialized answers out.</h2>
      </div>
      <div class="boundary-copy">
        <p>
          A specification stays Boolean. A separate immutable search can add
          sorting and paging without leaking EF, `DbSet`, or `IQueryable`.
        </p>
        <a class="text-link" href="/docs/ef-core/">Understand the EF Core boundary <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
